# Copy to .env and fill in. Never commit .env.
# Generated in TopstepX: Settings -> API (needs the paid ProjectX API subscription)
PROJECTX_USERNAME=your_topstepx_username
PROJECTX_API_KEY=your_api_key_here
# Timezone for display (data is stored in UTC)
TRADELAB_TZ=Europe/London
# Optional AI coach
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# COACH_MODEL=claude-sonnet-5

# Journal replay is disabled by default. Enable ONLY after confirming provider
# rights, credential scope and who may view data. Workspace keys are server IDs,
# not email addresses. Never use a wildcard or assume personal access covers users.
JOURNAL_REPLAY_PROJECTX_APPROVED=0
JOURNAL_REPLAY_PROJECTX_WORKSPACES=
JOURNAL_REPLAY_DUKASCOPY_APPROVED=0
JOURNAL_REPLAY_DUKASCOPY_WORKSPACES=
