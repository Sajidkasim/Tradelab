# Copy to .env and fill in. Never commit .env.
# Generated in TopstepX: Settings -> API (needs the paid ProjectX API subscription)
PROJECTX_USERNAME=your_topstepx_username
PROJECTX_API_KEY=your_api_key_here
# Timezone for display (data is stored in UTC)
TRADELAB_TZ=Europe/London
# Optional AI coach
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# COACH_MODEL=claude-sonnet-5
