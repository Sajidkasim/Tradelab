FROM node:22-alpine AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY assets/ /build/assets/
COPY static/ /build/static/
RUN npm run build

FROM python:3.13-slim
WORKDIR /app
COPY requirements-common.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements-web.txt
COPY core/ core/
COPY extensions/ extensions/
COPY services/ services/
COPY strategies/ strategies/
COPY webapp/ webapp/
COPY tools/refresh_matrix.py tools/refresh_matrix.py
COPY docs/licenses/ docs/licenses/
COPY --from=frontend /build/frontend/dist frontend/dist/
RUN useradd --create-home --uid 10001 primus
USER primus
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn webapp.app:create_app --factory --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --no-access-log"]
