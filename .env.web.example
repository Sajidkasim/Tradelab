# Hosted rebuild only. Store real values in your host's secret settings.
# Do not enable PRIMUSLAB_WEB_LOCAL_ONLY on a public deployment.
PRIMUSLAB_PUBLIC_URL=https://your-new-primuslab-host.example
TRADELAB_DB_URL=postgresql://YOUR_DATABASE_CONNECTION
PRIMUSLAB_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PRIMUSLAB_PASSWORD_HASH=REPLACE_WITH_HASH_FROM_PASSWORD_SETUP_HELPER

# Optional private per-person Google journals. Read GOOGLE_LOGIN.md before cutover.
PRIMUSLAB_AUTH_MODE=password
PRIMUSLAB_LAB_PATH=
PRIMUSLAB_CUSTOM_HOST=
PRIMUSLAB_LEGACY_HOST=
# PRIMUSLAB_AUTH_MODE=google
# PRIMUSLAB_OWNER_EMAIL=owner@example.com
# PRIMUSLAB_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# PRIMUSLAB_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PROJECT_PUBLISHABLE_KEY

# Optional private Journal screenshots. Set all four in Render, never in frontend code.
# Leave all unset to keep hosted uploads disabled. Local previews use temporary files.
# PRIMUS_R2_ACCOUNT_ID=
# PRIMUS_R2_BUCKET=
# PRIMUS_R2_ACCESS_KEY_ID=
# PRIMUS_R2_SECRET_ACCESS_KEY=

# Optional Aura review. Set the key and a Gemini model with vision and tool support.
# COACH_API_KEY=
# COACH_GEMINI_MODEL=
# Optional exact verified Google sign-in addresses for personalized names.
# COACH_SAJID_EMAIL=
# COACH_SAFWAAN_EMAIL=
# COACH_MUBEEN_EMAIL=
# COACH_MUSTAFA_EMAIL=
# COACH_AMIR_EMAIL=

# Optional Journal Cloudflare assistance. Local OCR needs no credentials.
# Use an account on Workers Free with no AI Gateway credits for this feature.
# PRIMUS_VISION_CF_FREE_ONLY=1
# PRIMUS_VISION_CF_ACCOUNT_ID=
# PRIMUS_VISION_CF_TOKEN=
