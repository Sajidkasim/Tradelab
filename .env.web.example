# Hosted rebuild only. Store real values in your host's secret settings.
# Do not enable PRIMUSLAB_WEB_LOCAL_ONLY on a public deployment.
PRIMUSLAB_PUBLIC_URL=https://your-new-primuslab-host.example
TRADELAB_DB_URL=postgresql://YOUR_DATABASE_CONNECTION
PRIMUSLAB_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PRIMUSLAB_PASSWORD_HASH=REPLACE_WITH_HASH_FROM_PASSWORD_SETUP_HELPER

# Optional private per-person Google journals. Read GOOGLE_LOGIN.md before cutover.
PRIMUSLAB_AUTH_MODE=password
# PRIMUSLAB_AUTH_MODE=google
# PRIMUSLAB_OWNER_EMAIL=owner@example.com
# PRIMUSLAB_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# PRIMUSLAB_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
